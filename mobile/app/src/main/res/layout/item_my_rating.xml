<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#1A2438"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Service Name and Rating -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvServiceName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Service Name"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/ratingStarsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </LinearLayout>

        <!-- Service Category -->
        <TextView
            android:id="@+id/tvServiceCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category"
            android:textColor="#38B6FF"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

        <!-- Rating Date -->
        <TextView
            android:id="@+id/tvRatingDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rated on: "
            android:textColor="#7A8499"
            android:textSize="11sp"
            android:layout_marginTop="8dp" />

        <!-- Feedback Text -->
        <TextView
            android:id="@+id/tvFeedbackText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Feedback text here"
            android:textColor="#B0B7C9"
            android:textSize="13sp"
            android:layout_marginTop="8dp"
            android:maxLines="3"
            android:ellipsize="end" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A3448"
            android:layout_marginTop="12dp" />

        <!-- Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/btnDeleteRating"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Delete"
                android:textColor="#FF6B6B"
                android:textSize="12sp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_delete_button" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>