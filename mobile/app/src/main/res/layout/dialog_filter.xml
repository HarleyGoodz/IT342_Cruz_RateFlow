<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/background_with_border"
    android:padding="20dp"
    android:elevation="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Filter by Category"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnFoodHospitality"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Food and Hospitality"
        android:background="@drawable/bg_filter_option"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnMedicalHealth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Medical and Health"
        android:background="@drawable/bg_filter_option"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnRetailCommercial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Retail and Commercial"
        android:background="@drawable/bg_filter_option"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnPersonalLifestyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Personal and Lifestyle"
        android:background="@drawable/bg_filter_option"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2A3A5A"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnClearFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Clear Filter"
        android:background="@drawable/bg_clear_filter"
        android:textColor="#00BFFF"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cancel"
        android:background="@drawable/bg_cancel_filter"
        android:textColor="#888888" />

</LinearLayout>