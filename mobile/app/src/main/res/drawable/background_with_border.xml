<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background color -->
    <solid android:color="#1A2A4A"/>

    <!-- Border -->
    <stroke
        android:width="2dp"
        android:color="#FFFFFF"/>

    <!-- Rounded corners (optional but recommended for modern UI) -->
    <corners android:radius="12dp"/>

    <!-- Inner padding -->
    <padding
        android:left="20dp"
        android:top="20dp"
        android:right="20dp"
        android:bottom="20dp"/>
</shape>